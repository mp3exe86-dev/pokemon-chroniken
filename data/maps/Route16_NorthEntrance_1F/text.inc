Route16_NorthEntrance_1F_Text_NoPedestriansOnCyclingRoad::
    .string "Cycling Road is\n"
    .string "for cyclists only.\p"
    .string "Something else uses\n"
    .string "it at night.\p"
    .string "It doesn't need a bike.$"

Route16_NorthEntrance_1F_Text_CyclingRoadIsDownhillCourse::
    .string "Cycling Road goes\n"
    .string "downhill by the sea.\p"
    .string "The sea looks\n"
    .string "different lately.\p"
    .string "Don't stare at it.$"

Route16_NorthEntrance_1F_Text_ExcuseMeWaitUp::
    .string "Wait up please.\p"
    .string "I've been trying\n"
    .string "to leave this road\p"
    .string "for an hour.$"

Route16_NorthEntrance_1F_Text_HowdYouGetInGoodEffort::
    .string "You made it through.\p"
    .string "Ride fast.\p"
    .string "Don't stop on\n"
    .string "the road.$"

