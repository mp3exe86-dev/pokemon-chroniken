Route16_Text_LaoIntro::
    .string "What do you want?\p"
    .string "I've been asking that\n"
    .string "for two days.\p"
    .string "Everything here\n"
    .string "wants something.$"

Route16_Text_LaoDefeat::
    .string "Still asking.$"

Route16_Text_LaoPostBattle::
    .string "Whatever it wants\n"
    .string "it isn't taking it\p"
    .string "from me directly.$"

Route16_Text_KojiIntro::
    .string "Nice bike.\p"
    .string "Mine stopped working\n"
    .string "this morning.\p"
    .string "No reason.\n"
    .string "Just stopped.$"

Route16_Text_KojiDefeat::
    .string "Yours still works.$"

Route16_Text_KojiPostBattle::
    .string "Something drained it.\p"
    .string "Not the battery.$"

Route16_Text_LukeIntro::
    .string "Come out and play.\p"
    .string "Something has been\n"
    .string "playing with us\p"
    .string "all day.\p"
    .string "We didn't invite it.$"

Route16_Text_LukeDefeat::
    .string "It's still playing.$"

Route16_Text_LukePostBattle::
    .string "It doesn't stop\n"
    .string "when we do.$"

Route16_Text_HideoIntro::
    .string "You bumped into me.\p"
    .string "Something else bumped\n"
    .string "into me last night.\p"
    .string "You I can see.$"

Route16_Text_HideoDefeat::
    .string "At least I felt that.$"

Route16_Text_HideoPostBattle::
    .string "The other thing\n"
    .string "left no mark.\p"
    .string "Just cold.$"

Route16_Text_CamronIntro::
    .string "I'm hungry and mean.\p"
    .string "Something on this\n"
    .string "route made me\p"
    .string "this way.\p"
    .string "I wasn't like\n"
    .string "this before.$"

Route16_Text_CamronDefeat::
    .string "That helped.$"

Route16_Text_CamronPostBattle::
    .string "A little less mean.\p"
    .string "Still hungry though.$"

Route16_Text_RubenIntro::
    .string "Let's have a\n"
    .string "good time.\p"
    .string "The last good time\n"
    .string "I had on this route\p"
    .string "was three days ago.\p"
    .string "Before I saw it.$"

Route16_Text_RubenDefeat::
    .string "Good time.$"

Route16_Text_RubenPostBattle::
    .string "Thank you.\p"
    .string "I needed that.$"

Route16_Text_MonSprawledOutInSlumber::
    .string "A POKéMON is sprawled out in\n"
    .string "a deep and comfortable slumber.$"

Route16_Text_CyclingRoadSign::
    .string "Enjoy the slope!\n"
    .string "CYCLING ROAD$"

Route16_Text_RouteSign::
    .string "STURMSEKTOR I\n"
    .string "JADENTHAL - DORNVAEL$"

Route16_Text_JedIntro::
    .string "JED: Our love knows\n"
    .string "no bounds.\p"
    .string "JED: Something here tested\n"
    .string "that.\p"
    .string "JED: We're still here.$"

Route16_Text_JedDefeat::
    .string "JED: Still here.$"

Route16_Text_JedPostBattle::
    .string "JED: Whatever it was\n"
    .string "couldn't separate us.\p"
    .string "JED: I don't know\n"
    .string "if it tried.$"

Route16_Text_JedNotEnoughMons::
    .string "JED: You have just one POKéMON?\n"
    .string "Is there no love in your heart?$"

Route16_Text_LeaIntro::
    .string "LEA: Sometimes the intensity\n"
    .string "of our love\p"
    .string "scares me.\p"
    .string "LEA: Something out here\n"
    .string "scares me more.\p"
    .string "LEA: So the love\n"
    .string "feels manageable now.$"

Route16_Text_LeaDefeat::
    .string "LEA: Perspective.$"

Route16_Text_LeaPostBattle::
    .string "LEA: Thank you for\n"
    .string "reminding me what\p"
    .string "normal fear feels like.$"

Route16_Text_LeaNotEnoughMons::
    .string "LEA: Oh, you don't have two\n"
    .string "POKéMON with you?\p"
    .string "Doesn't it feel lonely for you or\n"
    .string "your POKéMON?$"
