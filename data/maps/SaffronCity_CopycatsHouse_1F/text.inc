SaffronCity_CopycatsHouse_1F_Text_DaughterIsSelfCentered::
    .string "My daughter is\n"
    .string "self-centered.\n"
    .string "Few friends.\p"
    .string "She made a\n"
    .string "new one last week.\p"
    .string "We didn't see it.\p"
    .string "The clocks in\n"
    .string "her room ran\n"
    .string "backward that night.\p"
    .string "We reset them.\p"
    .string "They ran backward again.$"

SaffronCity_CopycatsHouse_1F_Text_DaughterLikesToMimicPeople::
    .string "My daughter mimics people.\n"
    .string "Vexing.\p"
    .string "She earned the\n"
    .string "nickname Copycat.\p"
    .string "Last week she\n"
    .string "mimicked something that\n"
    .string "didn't make a sound.\p"
    .string "She was very\n"
    .string "still for an hour.\p"
    .string "When she came\n"
    .string "back she was\n"
    .string "an hour older.$"

SaffronCity_CopycatsHouse_1F_Text_Chansey::
    .string "CHANSEY: Chaan! Sii!\p"
    .string "CHANSEY won't go\n"
    .string "upstairs anymore.$"
