SaffronCity_House_Text_DontLookAtMyLetter::
    .string "Thank you for writing.\n"
    .string "Hope to see\n"
    .string "you soon.\p"
    .string "Hey!\n"
    .string "Don't look at\n"
    .string "my letter!\p"
    .string "I wrote it\n"
    .string "three days ago.\p"
    .string "My friend says\n"
    .string "she received it\n"
    .string "yesterday.\p"
    .string "Before I sent it.$"

SaffronCity_House_Text_Pidgey::
    .string "PIDGEY: Kurukkoo!\p"
    .string "PIDGEY delivered a\n"
    .string "letter that hasn't\n"
    .string "been written yet.$"

SaffronCity_House_Text_GettingCopycatPokeDoll::
    .string "The Copycat is cute.\n"
    .string "Getting her a\n"
    .string "Poke Doll.\p"
    .string "She started mimicking\n"
    .string "something last week\n"
    .string "that wasn't in\n"
    .string "the room.\p"
    .string "She stopped after\n"
    .string "an hour.\n"
    .string "She doesn't remember it.$"

SaffronCity_House_Text_ExplainPPUp::
    .string "I was given\n"
    .string "a PP UP.\n"
    .string "Increases PP of\n"
    .string "a move.\p"
    .string "I should use\n"
    .string "it on a\n"
    .string "powerful move.\p"
    .string "I wrote this\n"
    .string "letter tomorrow.\n"
    .string "I don't know\n"
    .string "how I know that.$"
