Route11_Text_HugoIntro::
    .string "Win, lose, or draw.\p"
    .string "It doesn't matter\n"
    .string "anymore.\p"
    .string "Something changed\n"
    .string "the stakes.$"

Route11_Text_HugoDefeat::
    .string "Draw.$"

Route11_Text_HugoPostBattle::
    .string "I used to care\n"
    .string "which one it was.$"

Route11_Text_JasperIntro::
    .string "I've battled every\n"
    .string "trainer on this route.\p"
    .string "Something on this\n"
    .string "route battles back.$"

Route11_Text_JasperDefeat::
    .string "It won.$"

Route11_Text_JasperPostBattle::
    .string "Not a Pokemon.\n"
    .string "Something else.$"

Route11_Text_EddieIntro::
    .string "I've been waiting\n"
    .string "here for someone to\p"
    .string "challenge me.\p"
    .string "I don't know\n"
    .string "how long.$"

Route11_Text_EddieDefeat::
    .string "Still waiting.$"

Route11_Text_EddiePostBattle::
    .string "Time moves differently\n"
    .string "on this route.\p"
    .string "I've noticed.$"

Route11_Text_BraxtonIntro::
    .string "I'm laying cables\n"
    .string "for the Runenwerk Velkaris.\p"
    .string "The workers there\n"
    .string "all quit last week.\p"
    .string "No one said why.$"

Route11_Text_BraxtonDefeat::
    .string "I understand now.$"

Route11_Text_BraxtonPostBattle::
    .string "I'm finishing\n"
    .string "this job and leaving.\p"
    .string "I won't be back.$"

Route11_Text_DillonIntro::
    .string "I just started\n"
    .string "my journey.\p"
    .string "Everyone I met\n"
    .string "looked worried.$"

Route11_Text_DillonDefeat::
    .string "Now I know why.$"

Route11_Text_DillonPostBattle::
    .string "Don't go to\n"
    .string "Nebelruf alone.$"

Route11_Text_DirkIntro::
    .string "I have never lost.\p"
    .string "Until three nights ago\n"
    .string "something beat me\p"
    .string "without showing itself.$"

Route11_Text_DirkDefeat::
    .string "Twice now.$"

Route11_Text_DirkPostBattle::
    .string "I don't know\n"
    .string "what it wants.$"

Route11_Text_DarianIntro::
    .string "I have never won.\p"
    .string "Maybe that's why\n"
    .string "it hasn't noticed me.$"

Route11_Text_DarianDefeat::
    .string "It noticed.$"

Route11_Text_DarianPostBattle::
    .string "Losing might be\n"
    .string "the only safe thing.$"

Route11_Text_YasuIntro::
    .string "I train every\n"
    .string "morning at dawn.\p"
    .string "Something watches\n"
    .string "from the grass.\p"
    .string "It's there every day.$"

Route11_Text_YasuDefeat::
    .string "Still watching.$"

Route11_Text_YasuPostBattle::
    .string "I pretend not\n"
    .string "to see it.\p"
    .string "I think that helps.$"

Route11_Text_BernieIntro::
    .string "Watch for live wires.\p"
    .string "Also watch for\n"
    .string "things that look\p"
    .string "like live wires\n"
    .string "but aren't.$"

Route11_Text_BernieDefeat::
    .string "You weren't watching.$"

Route11_Text_BerniePostBattle::
    .string "There's a difference\n"
    .string "between electricity\p"
    .string "and something else.$"

Route11_Text_DaveIntro::
    .string "I raised my Pokemon\n"
    .string "for months.\p"
    .string "This morning they\n"
    .string "wouldn't come out\p"
    .string "of their Pokeballs.$"

Route11_Text_DaveDefeat::
    .string "Still won't.$"

Route11_Text_DavePostBattle::
    .string "They can sense\n"
    .string "things I can't.$"

Route11_Text_DiglettsCave::
    .string "GRUBDORN$"

