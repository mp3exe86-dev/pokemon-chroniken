CeladonCity_Restaurant_Text_TakingBreakRightNow::
    .string "Hi!\p"
    .string "Sorry, but we're taking a break\n"
    .string "right now.$"

CeladonCity_Restaurant_Text_OftenGoToDrugstore::
    .string "My Pokemon are\n"
    .string "weak.\n"
    .string "Often go to\n"
    .string "the Drugstore.\p"
    .string "My Pokemon have\n"
    .string "been more nervous\n"
    .string "than weak lately.\p"
    .string "They sense ProtoGlyph\n"
    .string "before I do.$"

CeladonCity_Restaurant_Text_PsstBasementUnderGameCorner::
    .string "Psst!\n"
    .string "There's a basement\n"
    .string "under the Game Corner.\p"
    .string "There's also something\n"
    .string "under the streets\n"
    .string "near the east wall.\p"
    .string "Not a basement.\n"
    .string "Deeper.\p"
    .string "ProtoGlyph travels underground.$"

CeladonCity_Restaurant_Text_ManLostItAllAtSlots::
    .string "The man at\n"
    .string "that table lost\n"
    .string "it all at slots.\p"
    .string "That man at\n"
    .string "the window lost\n"
    .string "something else last night.\p"
    .string "He saw ProtoGlyph\n"
    .string "pass.\p"
    .string "He won't say\n"
    .string "what he lost.\n"
    .string "Just sits there.$"

CeladonCity_Restaurant_Text_TakeThisImBusted::
    .string "Go ahead! Laugh!\n"
    .string "I'm flat-out busted!\p"
    .string "No more slots for me!\n"
    .string "I'm going straight!\p"
    .string "Here!\n"
    .string "I won't be needing this anymore!$"

CeladonCity_Restaurant_Text_ReceivedCoinCaseFromMan::
    .string "{PLAYER} received a COIN CASE\n"
    .string "from the man.$"

CeladonCity_Restaurant_Text_MakeRoomForThis::
    .string "Make room for this!$"

CeladonCity_Restaurant_Text_ThoughtIdWinItBack::
    .string "I always thought\n"
    .string "I was going\n"
    .string "to win it back.\p"
    .string "I thought the\n"
    .string "same about sleep.\p"
    .string "ProtoGlyph took three\n"
    .string "hours from this\n"
    .string "block last Tuesday.\n"
    .string "Nobody noticed until Wednesday.$"

