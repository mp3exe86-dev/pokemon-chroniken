CeruleanCity_ArchivarHouse_Text_Challenge:
	.string "You found this place.\n"
	.string "Not many do.\p"
	.string "I keep records\n"
	.string "of four names.\p"
	.string "ProtoGlyph.\n"
	.string "Aeralith.\p"
	.string "Nullveil.\n"
	.string "Chronyx.\p"
	.string "Do you seek\n"
	.string "knowledge or power?$"

CeruleanCity_ArchivarHouse_Text_NoChoice:
	.string "Wise choice.\n"
	.string "Take this.\p"
	.string "You will need it\n"
	.string "more than I do.$"

CeruleanCity_ArchivarHouse_Text_ObtainedMasterBall:
	.string "You received the\n"
	.string "MASTER BALL!$"

CeruleanCity_ArchivarHouse_Text_Lose:
	.string "You are not\n"
	.string "ready yet.\p"
	.string "Come back when\n"
	.string "the four names\l"
	.string "mean something\n"
	.string "to you.$"

CeruleanCity_ArchivarHouse_Text_Victory:
	.string "Remarkable.\n"
	.string "You know the names.\p"
	.string "The path forward\n"
	.string "is yours.$"

CeruleanCity_ArchivarHouse_Text_OfferStands:
	.string "The offer stands.\n"
	.string "But the path\l"
	.string "requires more.$"

CeruleanCity_ArchivarHouse_Text_BagFull:
	.string "Your bag is full.\n"
	.string "Return when you\l"
	.string "have made room.$"
