PalletTown_PlayersHouse_2F_Text_BurntFeather:
        .string "A burnt feather.\nIt wasn't here yesterday.\pSomething about it\nfeels warm.\pTake it?$"

PalletTown_PlayersHouse_2F_Text_BlackStone:
        .string "A black stone\nwith a single scratch.\pCold to the touch.\nAlmost familiar.\pTake it?$"

PalletTown_PlayersHouse_2F_Text_EmptyMirror:
        .string "A small mirror.\nIt shows no reflection.\pYou feel watched.\pTake it?$"

PalletTown_PlayersHouse_2F_Text_StarterAppears:
        .string "...\pIt was waiting.$"

PalletTown_PlayersHouse_2F_Text_AlreadyChosen:
        .string "The other objects\nsit perfectly still.\pAs if they were\nnever meant for you.$"
