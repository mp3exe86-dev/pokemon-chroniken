FuchsiaCity_Mart_Text_DontTheyHaveSafariZonePennants::
    .string "Don't they have\n"
    .string "Eryn Vorn pennants?\p"
    .string "Some paper lanterns?\n"
    .string "Calendars?\p"
    .string "They used to\n"
    .string "sell them.\p"
    .string "The souvenir stand\n"
    .string "in the west\n"
    .string "closed three weeks ago.\p"
    .string "The worker quit.\p"
    .string "Saw something at night.$"

FuchsiaCity_Mart_Text_DidYouTryXSpeed::
    .string "Did you try\n"
    .string "X Speed?\n"
    .string "Speeds up a\n"
    .string "Pokemon in battle.\p"
    .string "Nullveil doesn't need\n"
    .string "speed.\p"
    .string "It's already where\n"
    .string "it wants to be.$"
