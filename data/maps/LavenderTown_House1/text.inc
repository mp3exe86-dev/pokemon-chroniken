LavenderTown_House1_Text_Cubone::
    .string "CUBONE: Kyarugoo!\p"
    .string "CUBONE stares at\n"
    .string "the Tower window.$"

LavenderTown_House1_Text_RocketsKilledCubonesMother::
    .string "Those horrible Rockets!\n"
    .string "No mercy!\p"
    .string "That poor Cubone's\n"
    .string "mother killed trying\n"
    .string "to escape.\p"
    .string "She tried to\n"
    .string "warn us too.\p"
    .string "Not about Rockets.\p"
    .string "About something older.\p"
    .string "She didn't finish.$"

LavenderTown_House1_Text_GhostOfPokemonTowerIsGone::
    .string "The ghost of\n"
    .string "Nebelturm is gone.\p"
    .string "Someone soothed its\n"
    .string "restless spirit.\p"
    .string "The four names\n"
    .string "are quieter now.\p"
    .string "Not gone.\n"
    .string "Just quieter.$"

