Route9_Text_AliciaIntro::
    .string "The tunnel ahead\n"
    .string "has been making sounds.\p"
    .string "Not wind.\n"
    .string "Not Pokemon.$"

Route9_Text_AliciaDefeat::
    .string "You heard it too.$"

Route9_Text_AliciaPostBattle::
    .string "Use Flash in there.\p"
    .string "Not just for\n"
    .string "the darkness.$"

Route9_Text_ChrisIntro::
    .string "I set up camp here\n"
    .string "three days ago.\p"
    .string "I can't remember\n"
    .string "why I stopped.$"

Route9_Text_ChrisDefeat::
    .string "Still can't remember.$"

Route9_Text_ChrisPostBattle::
    .string "Keep walking.\p"
    .string "Don't camp here.$"

Route9_Text_DrewIntro::
    .string "I'm heading to\n"
    .string "Lavender Town.\p"
    .string "I don't know\n"
    .string "why.$"

Route9_Text_DrewDefeat::
    .string "Neither do I.$"

Route9_Text_DrewPostBattle::
    .string "Something is calling\n"
    .string "from that direction.\p"
    .string "I can't ignore it.$"

Route9_Text_CaitlinIntro::
    .string "Don't look at me\n"
    .string "like you know something.\p"
    .string "Do you know\n"
    .string "something?$"

Route9_Text_CaitlinDefeat::
    .string "You do.$"

Route9_Text_CaitlinPostBattle::
    .string "Tell me.\p"
    .string "I've been waiting\n"
    .string "for someone to tell me.$"

Route9_Text_JeremyIntro::
    .string "I came down from\n"
    .string "the mountain this morning.\p"
    .string "Something up there\n"
    .string "was watching me.$"

Route9_Text_JeremyDefeat::
    .string "It's still up there.$"

Route9_Text_JeremyPostBattle::
    .string "I'm not going back.\p"
    .string "Not for anything.$"

Route9_Text_BriceIntro::
    .string "I've been walking\n"
    .string "this route for hours.\p"
    .string "The tunnel keeps\n"
    .string "moving further away.$"

Route9_Text_BriceDefeat::
    .string "Still moving.$"

Route9_Text_BricePostBattle::
    .string "Just keep walking.\p"
    .string "You'll get there\n"
    .string "eventually.$"

Route9_Text_BrentIntro::
    .string "My cocoons hatched\n"
    .string "this morning.\p"
    .string "What came out wasn't\n"
    .string "what went in.$"

Route9_Text_BrentDefeat::
    .string "I don't know\n"
    .string "what they are.$"

Route9_Text_BrentPostBattle::
    .string "I'm not collecting\n"
    .string "anymore.$"

Route9_Text_AlanIntro::
    .string "I've climbed every\n"
    .string "mountain in Kanto.\p"
    .string "This one feels\n"
    .string "different now.$"

Route9_Text_AlanDefeat::
    .string "It changed.$"

Route9_Text_AlanPostBattle::
    .string "The rocks moved\n"
    .string "last night.\p"
    .string "Just slightly.$"

Route9_Text_ConnerIntro::
    .string "The bugs on this\n"
    .string "route are wrong.\p"
    .string "They have too\n"
    .string "many legs.$"

Route9_Text_ConnerDefeat::
    .string "Count them.$"

Route9_Text_ConnerPostBattle::
    .string "Don't look too\n"
    .string "closely at them.$"

Route9_Text_RouteSign::
    .string "ROUTE 9\n"
    .string "CERULEAN CITY - ROCK TUNNEL$"

