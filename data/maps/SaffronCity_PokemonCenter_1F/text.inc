SaffronCity_PokemonCenter_1F_Text_GrowthRatesDifferBySpecies::
    .string "Pokemon growth rates\n"
    .string "differ by species.\p"
    .string "My Pokemon grew\n"
    .string "three levels last\n"
    .string "Tuesday.\p"
    .string "I wasn't training it.\p"
    .string "Tuesday happened twice.$"

SaffronCity_PokemonCenter_1F_Text_SilphCoVictimOfFame::
    .string "Silph Durith is\n"
    .string "widely known.\p"
    .string "Victim of its\n"
    .string "own fame.\n"
    .string "Attracted Team Rocket.\p"
    .string "Chronyx was attracted\n"
    .string "by something else.\p"
    .string "Older than fame.\p"
    .string "Older than Silph.$"

SaffronCity_PokemonCenter_1F_Text_GreatIfEliteFourCameBeatRockets::
    .string "Wouldn't this be great.\n"
    .string "Elite Four stomps\n"
    .string "Team Rocket.\p"
    .string "We've been waiting\n"
    .string "for days.\p"
    .string "My watch says\n"
    .string "three hours.\p"
    .string "Both can't be right.$"

SaffronCity_PokemonCenter_1F_Text_TeamRocketTookOff::
    .string "Team Rocket is gone!\n"
    .string "Safe again!\n"
    .string "That's great!\p"
    .string "Time still feels\n"
    .string "wrong though.\p"
    .string "Some hours are\n"
    .string "shorter than others.\p"
    .string "Chronyx is still here.$"
