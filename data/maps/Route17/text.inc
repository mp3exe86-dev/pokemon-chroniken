Route17_Text_RaulIntro::
    .string "There's no quick\n"
    .string "way through anything\p"
    .string "worth doing.\p"
    .string "This road taught\n"
    .string "me that.\p"
    .string "The hard way.$"

Route17_Text_RaulDefeat::
    .string "Took me longer.$"

Route17_Text_RaulPostBattle::
    .string "Something on this\n"
    .string "road slows you down\p"
    .string "on purpose.$"

Route17_Text_IsaiahIntro::
    .string "I've ridden every\n"
    .string "road in Kanto.\p"
    .string "This one rides\n"
    .string "differently at night.\p"
    .string "Like something rides\n"
    .string "alongside you.$"

Route17_Text_IsaiahDefeat::
    .string "You felt it too.$"

Route17_Text_IsaiahPostBattle::
    .string "Don't ride this\n"
    .string "road after dark.$"

Route17_Text_VirgilIntro::
    .string "Heading to Fuchsia?\p"
    .string "I've been going there\n"
    .string "for three hours.\p"
    .string "The road keeps\n"
    .string "bringing me back.$"

Route17_Text_VirgilDefeat::
    .string "Again.$"

Route17_Text_VirgilPostBattle::
    .string "Maybe you'll make it.\p"
    .string "I'll try again tomorrow.$"

Route17_Text_BillyIntro::
    .string "We rule these roads.\p"
    .string "Used to.\p"
    .string "Something rules this\n"
    .string "one now.\p"
    .string "We just ride through\n"
    .string "as fast as we can.$"

Route17_Text_BillyDefeat::
    .string "Fast isn't fast enough.$"

Route17_Text_BillyPostBattle::
    .string "Keep moving.\p"
    .string "Don't let the road\n"
    .string "feel like yours.$"

Route17_Text_NikolasIntro::
    .string "My Pokemon started\n"
    .string "acting strange\p"
    .string "when we hit\n"
    .string "the middle of\p"
    .string "this road.\p"
    .string "Like something pressed\n"
    .string "against them from above.$"

Route17_Text_NikolasDefeat::
    .string "Still pressing.$"

Route17_Text_NikolasPostBattle::
    .string "Don't look up\n"
    .string "while you ride.$"

Route17_Text_ZeekIntro::
    .string "My Pokemon won't\n"
    .string "evolve.\p"
    .string "I thought I\n"
    .string "knew why.\p"
    .string "Now I think\n"
    .string "something is preventing it.$"

Route17_Text_ZeekDefeat::
    .string "It's watching.$"

Route17_Text_ZeekPostBattle::
    .string "Whatever it is\n"
    .string "doesn't want things\p"
    .string "to change.$"

Route17_Text_JamalIntro::
    .string "I needed exercise.\p"
    .string "I've been riding\n"
    .string "for six hours.\p"
    .string "I can't stop.$"

Route17_Text_JamalDefeat::
    .string "Still going.$"

Route17_Text_JamalPostBattle::
    .string "My legs won't\n"
    .string "stop on this road.\p"
    .string "Maybe yours will.$"

Route17_Text_CoreyIntro::
    .string "Be a rebel.\p"
    .string "That's what I said\n"
    .string "before I saw\p"
    .string "what's at the\n"
    .string "bottom of this road.$"

Route17_Text_CoreyDefeat::
    .string "You didn't see it.$"

Route17_Text_CoreyPostBattle::
    .string "You will.$"

Route17_Text_JaxonIntro::
    .string "Nice bike.\p"
    .string "How does it handle\n"
    .string "when something tries\p"
    .string "to steer for you?\p"
    .string "You'll find out.$"

Route17_Text_JaxonDefeat::
    .string "You handled it.$"

Route17_Text_JaxonPostBattle::
    .string "For now.$"

Route17_Text_WilliamIntro::
    .string "I'm exhausted.\p"
    .string "I've been riding\n"
    .string "away from something\p"
    .string "since sunrise.\p"
    .string "It keeps the\n"
    .string "same distance.$"

Route17_Text_WilliamDefeat::
    .string "It's still there.$"

Route17_Text_WilliamPostBattle::
    .string "It won't close in.\p"
    .string "It just watches\n"
    .string "you get tired.$"

Route17_Text_WatchOutForDiscardedItems::
    .string "CYCLING ROAD\n"
    .string "Fuchsia City ahead.\p"
    .string "Some riders never\n"
    .string "arrive.$"

Route17_Text_SameSpeciesGrowDifferentRates::
    .string "Maintain speed.\p"
    .string "Things that stop\n"
    .string "moving on this road\p"
    .string "don't start again.$"

Route17_Text_PressBToStayInPlace::
    .string "Do not look\n"
    .string "to the sides.\p"
    .string "The road is\n"
    .string "narrower than it appears.$"

Route17_Text_RouteSign::
    .string "ROUTE 17\n"
    .string "CELADON CITY - FUCHSIA CITY$"

Route17_Text_DontThrowGameThrowBalls::
    .string "You are being\n"
    .string "watched.\p"
    .string "This is normal.$"

Route17_Text_CyclingRoadSign::
    .string "CYCLING ROAD\n"
    .string "Slope ends here!$"

