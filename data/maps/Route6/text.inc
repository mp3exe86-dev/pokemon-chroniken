Route6_Text_RickyIntro::
    .string "Someone was watching\n"
    .string "our camp last night.\p"
    .string "No footprints\n"
    .string "in the morning.$"

Route6_Text_RickyDefeat::
    .string "I can't win anything.$"

Route6_Text_RickyPostBattle::
    .string "Whisper...\n"
    .string "Whisper...$"

Route6_Text_NancyIntro::
    .string "This was supposed to be\n"
    .string "a quiet route.\p"
    .string "It isn't anymore.$"

Route6_Text_NancyDefeat::
    .string "Nothing is.$"

Route6_Text_NancyPostBattle::
    .string "Whisper...\n"
    .string "Whisper...$"

Route6_Text_KeigoIntro::
    .string "The bugs here don't\n"
    .string "behave like they used to.\p"
    .string "They stopped hiding.$"

Route6_Text_KeigoDefeat::
    .string "Even they know something.$"

Route6_Text_KeigoPostBattle::
    .string "I'm going back to\n"
    .string "Viridian Forest.\p"
    .string "At least there I\n"
    .string "understand what I see.$"

Route6_Text_JeffIntro::
    .string "I brought six Pokemon.\p"
    .string "Only three respond\n"
    .string "to me now.$"

Route6_Text_JeffDefeat::
    .string "Four now.$"

Route6_Text_JeffPostBattle::
    .string "I should go home.\p"
    .string "I don't know\n"
    .string "where that is.$"

Route6_Text_IsabelleIntro::
    .string "I've been standing here\n"
    .string "for an hour.\p"
    .string "I forgot where\n"
    .string "I was going.$"

Route6_Text_IsabelleDefeat::
    .string "It doesn't matter.$"

Route6_Text_IsabellePostBattle::
    .string "Do you remember\n"
    .string "where you came from?\p"
    .string "I don't.$"

Route6_Text_ElijahIntro::
    .string "You look like you've\n"
    .string "seen something.\p"
    .string "Have you?$"

Route6_Text_ElijahDefeat::
    .string "You have.$"

Route6_Text_ElijahPostBattle::
    .string "Don't tell me.\p"
    .string "I don't want\n"
    .string "to know.$"

Route6_Text_UndergroundPathSign::
    .string "UNDERGROUND PATH\n"
    .string "TIEFBRUCH - MORLOND$"

