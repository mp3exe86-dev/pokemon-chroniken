LavenderTown_Mart_Text_SearchingForStatRaiseItems::
    .string "I'm searching for\n"
    .string "items that raise\n"
    .string "Pokemon stats.\p"
    .string "X Attack.\n"
    .string "X Defend.\n"
    .string "X Speed.\n"
    .string "X Special.\p"
    .string "Do you know\n"
    .string "where to find them?\p"
    .string "Also.\p"
    .string "Do you know\n"
    .string "what ProtoGlyph means?\p"
    .string "I heard it\n"
    .string "in my sleep\n"
    .string "last night.\p"
    .string "I've never been\n"
    .string "to the Tower.$"

LavenderTown_Mart_Text_DidYouBuyRevives::
    .string "Buy some Revives.\n"
    .string "They revive fainted Pokemon.\p"
    .string "I needed one\n"
    .string "after I visited\n"
    .string "the Tower at night.\p"
    .string "Not from a battle.\p"
    .string "Just from hearing\n"
    .string "the names.$"

LavenderTown_Mart_Text_TrainerDuosCanChallengeYou::
    .string "Sometimes a Trainer\n"
    .string "duo challenges you\n"
    .string "with two Pokemon.\p"
    .string "You send out\n"
    .string "two Pokemon too.\p"
    .string "The Tower ghosts\n"
    .string "work differently.\p"
    .string "Four of them.\p"
    .string "Four names.\p"
    .string "Always together.$"

LavenderTown_Mart_Text_SoldNuggetFromMountainsFor5000::
    .string "この　あいだ　やまおくで\n"
    .string "きんのたまを　ひろい　ましてね！\p"
    .string "つかえない　しなもの　ですが\n"
    .string "うったら　なんと　5000¥でした$"
