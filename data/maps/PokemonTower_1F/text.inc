PokemonTower_1F_Text_ErectedInMemoryOfDeadMons::
    .string "This Tower was built\n"
    .string "for Pokemon that died.\p"
    .string "Something here was\n"
    .string "not built for them.$"

PokemonTower_1F_Text_ComeToPayRespectsSon::
    .string "Did you come\n"
    .string "to pay respects?\p"
    .string "Something else came\n"
    .string "here for a\n"
    .string "different reason.\p"
    .string "It's still here.$"

