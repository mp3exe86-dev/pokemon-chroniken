PokemonTower_1F_Text_CameToPrayForDepartedClefairy::
    .string "I came to\n"
    .string "pray for my\n"
    .string "Clefairy.\p"
    .string "Sniff.\p"
    .string "Something prayed back.\p"
    .string "I don't know\n"
    .string "what it wanted.$"

PokemonTower_1F_Text_GrowlitheWhyDidYouDie::
    .string "My Growlithe.\p"
    .string "Why did you die?\p"
    .string "Something answered\n"
    .string "that question.\p"
    .string "I wish it hadn't.$"

PokemonTower_1F_Text_SenseSpiritsUpToMischief::
    .string "I am a Channeler.\p"
    .string "The spirits above\n"
    .string "are not mischievous.\p"
    .string "They are frightened.$"
