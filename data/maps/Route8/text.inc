Route8_Text_AidanIntro::
    .string "My calculations show\n"
    .string "something is wrong\p"
    .string "with the air here.$"

Route8_Text_AidanDefeat::
    .string "The air is wrong.$"

Route8_Text_AidanPostBattle::
    .string "I don't have\n"
    .string "a formula for this.$"

Route8_Text_StanIntro::
    .string "Let's play a game.\p"
    .string "First one to look\n"
    .string "behind them loses.$"

Route8_Text_StanDefeat::
    .string "I looked.$"

Route8_Text_StanPostBattle::
    .string "Don't look behind you.\p"
    .string "I mean it.$"

Route8_Text_GlennIntro::
    .string "Statistically something\n"
    .string "is wrong with this route.\p"
    .string "The numbers don't\n"
    .string "add up anymore.$"

Route8_Text_GlennDefeat::
    .string "That wasn't logical.$"

Route8_Text_GlennPostBattle::
    .string "I've checked three times.\p"
    .string "The math keeps\n"
    .string "changing.$"

Route8_Text_PaigeIntro::
    .string "My Pokemon won't\n"
    .string "evolve anymore.\p"
    .string "They refuse.$"

Route8_Text_PaigeDefeat::
    .string "Even now.$"

Route8_Text_PaigePostBattle::
    .string "Maybe they know\n"
    .string "something I don't.$"

Route8_Text_LeslieIntro::
    .string "I came out here\n"
    .string "to study the Pokemon.\p"
    .string "They started\n"
    .string "studying me back.$"

Route8_Text_LeslieDefeat::
    .string "They're still watching.$"

Route8_Text_LesliePostBattle::
    .string "I should go inside.\p"
    .string "I can't make\n"
    .string "myself move.$"

Route8_Text_AndreaIntro::
    .string "My Meowth stopped\n"
    .string "purring three days ago.\p"
    .string "It just stares\n"
    .string "at the road.$"

Route8_Text_AndreaDefeat::
    .string "Still staring.$"

Route8_Text_AndreaPostBattle::
    .string "It hasn't eaten\n"
    .string "either.\p"
    .string "I don't know\n"
    .string "what it sees.$"

Route8_Text_MeganIntro::
    .string "We've all been\n"
    .string "standing here for days.\p"
    .string "None of us decided\n"
    .string "to. We just stopped.$"

Route8_Text_MeganDefeat::
    .string "I still can't move.$"

Route8_Text_MeganPostBattle::
    .string "The gate is open now.\p"
    .string "I don't know\n"
    .string "why I'm still here.$"

Route8_Text_RichIntro::
    .string "I've been playing\n"
    .string "the same game for days.\p"
    .string "I keep getting\n"
    .string "the same ending.$"

Route8_Text_RichDefeat::
    .string "See? Same ending.$"

Route8_Text_RichPostBattle::
    .string "I don't know\n"
    .string "how to stop.$"

Route8_Text_JuliaIntro::
    .string "Something round\n"
    .string "and pale followed me\p"
    .string "here from Lavender.$"

Route8_Text_JuliaDefeat::
    .string "It's still there.$"

Route8_Text_JuliaPostBattle::
    .string "I'm not looking back.\p"
    .string "I don't want to\n"
    .string "know if it's closer.$"

Route8_Text_UndergroundPathSign::
    .string "UNDERGROUND PATH\n"
    .string "JADENTHAL - NEBELRUF$"

Route8_Text_EliIntro::
    .string "ELI: We used to finish\n"
    .string "each other's sentences.\p"
    .string "We both stopped\n"
    .string "talking yesterday.$"

Route8_Text_EliDefeat::
    .string "ELI: We both knew.$"

Route8_Text_EliPostBattle::
    .string "ELI: We haven't spoken\n"
    .string "since.$"

Route8_Text_EliNotEnoughMons::
    .string "ELI: We can't battle if you don't\n"
    .string "have two POKéMON.$"

Route8_Text_AnneIntro::
    .string "ANNE: We haven't spoken\n"
    .string "since yesterday.\p"
    .string "We both heard\n"
    .string "the same thing.$"

Route8_Text_AnneDefeat::
    .string "ANNE: We both lost.$"

Route8_Text_AnnePostBattle::
    .string "ANNE: Don't ask what\n"
    .string "we heard.$"

Route8_Text_AnneNotEnoughMons::
    .string "ANNE: Hi, hi! Let's battle!\n"
    .string "But bring two POKéMON.$"

Route8_Text_RicardoIntro::
    .string "My bike stopped\n"
    .string "working this morning.\p"
    .string "No reason.\n"
    .string "Just stopped.$"

Route8_Text_RicardoDefeat::
    .string "Still stopped.$"

Route8_Text_RicardoPostBattle::
    .string "Everything on\n"
    .string "this route just\p"
    .string "stops.$"

Route8_Text_JarenIntro::
    .string "I've been trying\n"
    .string "to leave this route\p"
    .string "for an hour.\p"
    .string "My legs keep\n"
    .string "bringing me back.$"

Route8_Text_JarenDefeat::
    .string "Back again.$"

Route8_Text_JarenPostBattle::
    .string "Don't stay too long.\p"
    .string "You might not\n"
    .string "be able to leave.$"
