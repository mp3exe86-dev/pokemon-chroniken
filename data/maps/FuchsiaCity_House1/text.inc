FuchsiaCity_House1_Text_WardenIsOldHasFalseTeeth::
    .string "The Safari Warden\n"
    .string "is old but active.\p"
    .string "All his teeth are false.\p"
    .string "He lost them\n"
    .string "the night he\n"
    .string "saw Nullveil near\n"
    .string "the west fence.\p"
    .string "He doesn't talk\n"
    .string "about that night.$"

FuchsiaCity_House1_Text_BillIsMyGrandson::
    .string "Hmm?\n"
    .string "You've met Bill?\p"
    .string "He's my grandson!\p"
    .string "He always liked\n"
    .string "collecting things.\n"
    .string "Even as a child.\p"
    .string "He called me\n"
    .string "last week.\p"
    .string "Asked about the\n"
    .string "four Watcher names.\p"
    .string "Very old question.$"

FuchsiaCity_House1_Text_BillFilesHisOwnMonData::
    .string "Bill files his\n"
    .string "own Pokemon data\n"
    .string "on his PC.\p"
    .string "He called Grandpa\n"
    .string "about something old.\p"
    .string "I heard Nullveil\n"
    .string "through the phone.\p"
    .string "Grandpa went very quiet.$"
