LavenderTown_Text_DoYouBelieveInGhosts::
    .string "Do you believe in ghosts?$"

LavenderTown_Text_SoThereAreBelievers::
    .string "Really?\n"
    .string "So there are believers.\p"
    .string "The ghosts in the\n"
    .string "Tower know names.\p"
    .string "Four names.\p"
    .string "They say them\n"
    .string "over and over\n"
    .string "at night.\p"
    .string "I've heard them.$"

LavenderTown_Text_JustImaginingWhiteHand::
    .string "Hahaha.\n"
    .string "I guess not.\p"
    .string "That white hand\n"
    .string "on your shoulder.\p"
    .string "I'm just imagining it.\p"
    .string "The names the\n"
    .string "ghosts repeat\n"
    .string "are also imaginary.\p"
    .string "ProtoGlyph.\n"
    .string "Aeralith.\n"
    .string "Nullveil.\n"
    .string "Chronyx.\p"
    .string "Just imagining.$"

LavenderTown_Text_TownKnownAsMonGraveSite::
    .string "This town is\n"
    .string "the grave site\n"
    .string "of Pokemon.\p"
    .string "Memorial services\n"
    .string "in Pokemon Tower.\p"
    .string "The Tower is\n"
    .string "quiet now.\p"
    .string "Except for the\n"
    .string "names it repeats\n"
    .string "at night.\p"
    .string "Four names.\p"
    .string "We don't go\n"
    .string "up there after dark.$"

LavenderTown_Text_GhostsAppearedInTower::
    .string "Ghosts appeared in\n"
    .string "Pokemon Tower.\p"
    .string "Spirits of Pokemon\n"
    .string "the Rockets killed.\p"
    .string "The ghosts know\n"
    .string "something the Rockets\n"
    .string "don't.\p"
    .string "They keep saying\n"
    .string "four names.\p"
    .string "The Rockets\n"
    .string "are afraid of them.$"

LavenderTown_Text_TownSign::
    .string "LAVENDER TOWN\n"
    .string "The Noble Purple Town\p"
    .string "The dead remember\n"
    .string "names the living\n"
    .string "have forgotten.$"

LavenderTown_Text_SilphScopeNotice::
    .string "New SILPH SCOPE!\n"
    .string "Make the Invisible\n"
    .string "Plain to See!\p"
    .string "Some things should\n"
    .string "stay invisible.$"

LavenderTown_Text_VolunteerPokemonHouse::
    .string "LAVENDER VOLUNTEER\n"
    .string "POKEMON HOUSE\p"
    .string "Mr. Fuji cares\n"
    .string "for the abandoned.\p"
    .string "He also keeps\n"
    .string "records of the\n"
    .string "four names.\p"
    .string "Very old records.$"

LavenderTown_Text_PokemonTowerSign::
    .string "POKEMON TOWER\n"
    .string "Becalm the Spirits\n"
    .string "of Pokemon\p"
    .string "The spirits are\n"
    .string "not calm.\p"
    .string "They are waiting.$"

