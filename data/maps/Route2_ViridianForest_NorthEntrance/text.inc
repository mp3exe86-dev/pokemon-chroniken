Route2_ViridianForest_NorthEntrance_Text_ManyMonsOnlyInForests::
    .string "The Pokemon in there\n"
    .string "don't act normal.\p"
    .string "They watch you\n"
    .string "before they attack.$"

Route2_ViridianForest_NorthEntrance_Text_CanCutSkinnyTrees::
    .string "I've walked past these\n"
    .string "trees for forty years.\p"
    .string "Last spring one of them\n"
    .string "moved on its own.\p"
    .string "I didn't look back.$"

Route2_ViridianForest_NorthEntrance_Text_CanCancelEvolution::
    .string "Something in this forest\n"
    .string "makes my Pokemon nervous.\p"
    .string "They won't tell me\n"
    .string "what they sense.$"

